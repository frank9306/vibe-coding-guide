{
  "$schema": "./vibe-standard.schema.json",
  "name": "frank-vibe-coding-standard",
  "schemaVersion": 3,
  "language": "zh-CN",
  "instructionLanguage": "en",
  "entrypoint": "INSTALL.md",
  "install": {
    "globalInstructions": {
      "source": "standard/AGENTS.md",
      "targetResolution": {
        "preferredEnvironmentVariable": "CODEX_HOME",
        "relativePath": "AGENTS.md",
        "requireAgentHome": true,
        "allowUserHomeFallback": false
      },
      "strategy": "preserve-or-review-merge",
      "personalization": {
        "required": true,
        "allowDefaults": true,
        "mode": "agent-guided-review-merge",
        "writeLanguage": "en",
        "preserveLiteralValues": true,
        "fields": [
          "identity-and-addressing",
          "language",
          "response-style"
        ]
      }
    },
    "skills": [
      {
        "name": "project-bootstrap",
        "source": "skills/project-bootstrap",
        "target": ".agents/skills/project-bootstrap"
      }
    ],
    "recommendedSkills": {
      "source": "tw93/Waza",
      "scope": "global",
      "installByDefault": false,
      "requiresExplicitApproval": true,
      "command": "npx skills add tw93/Waza --skill check --skill ui --skill health --skill hunt --skill learn --skill read --skill think --skill write -g",
      "skills": [
        "check",
        "ui",
        "health",
        "hunt",
        "learn",
        "read",
        "think",
        "write"
      ],
      "gates": [
        "show-source-command-and-skill-list",
        "check-existing-skills-and-conflicts",
        "explicit-user-approval",
        "verify-installed-skills"
      ]
    }
  },
  "apply": {
    "projectFiles": [
      {
        "source": "standard/project/AGENTS.md",
        "target": "AGENTS.md",
        "strategy": "preserve-or-project-aware-merge"
      },
      {
        "source": "standard/project/CLAUDE.md",
        "target": "CLAUDE.md",
        "strategy": "preserve-or-thin-adapter"
      }
    ]
  },
  "defaults": {
    "instructionSourceOfTruth": "AGENTS.md",
    "packageManagers": {
      "python": "uv",
      "frontend": "pnpm",
      "go": "go"
    },
    "verificationRequired": true,
    "minimumChangeScope": true
  },
  "approvalRequired": [
    "overwrite-existing-files",
    "install-or-upgrade-dependencies",
    "delete-files-or-data",
    "database-migrations",
    "authentication-or-authorization-changes",
    "git-commit-or-push",
    "deploy-or-publish",
    "send-private-data-to-third-parties",
    "install-recommended-third-party-skills"
  ],
  "policies": [
    "docs/skill-portfolio.md",
    "docs/mcp-plugin-policy.md",
    "docs/project-onboarding.md",
    "docs/security-and-maintenance.md"
  ]
}
